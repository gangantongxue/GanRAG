# GanRAG 环境变量模板：复制为 .env（已 gitignore）后修改
#   cp .env.example .env
#
# docker-compose（task infra）与数据库任务（task db-up / db-status / db-gen）共用本文件。

# MySQL root 密码（仅容器初始化用）
MYSQL_ROOT_PASSWORD=change-me-root

# 应用账号与密码（task db-* 与各服务数据库连接共用）
GANRAG_DB_USER=ganrag
GANRAG_DB_PASSWORD=change-me

# 可选：宿主机映射端口 / 数据库连接端口（默认 3306；改端口时 db 任务自动跟随）
# GANRAG_DB_PORT=3306

# 可选：数据库主机（默认 127.0.0.1；容器网络内访问用容器名 ganrag-mysql）
# GANRAG_DB_HOST=127.0.0.1
