# GanRAG 环境变量模板：复制为仓库根 .env 后修改（cp .env.example .env）
#
# 全项目统一读仓库根 .env：docker-compose（task infra）、task db-*、各服务启动
# （pkg/config 缺省自动加载仓库根 .env，-env 可显式覆盖）。
# 随机值一律命令生成（openssl rand），不要手填弱口令。

# ---- MySQL ----
# root 密码（仅容器初始化用）：openssl rand -base64 18
MYSQL_ROOT_PASSWORD=change-me-root
# 应用账号（task db-* 与 pkg/db 迁移工具读 GANRAG_DB_*）
GANRAG_DB_USER=ganrag
GANRAG_DB_PASSWORD=change-me
# 服务侧读取名（viper database.password 覆盖），与 GANRAG_DB_PASSWORD 保持同值
GANRAG_DATABASE_PASSWORD=change-me
# 可选：宿主机映射端口 / 数据库连接端口（默认 3306；改端口时 db 任务自动跟随）
# GANRAG_DB_PORT=3306
# 可选：数据库主机（容器网络内用容器名 ganrag-mysql，本地默认 127.0.0.1）
# GANRAG_DATABASE_HOST=ganrag-mysql

# ---- Redis（task infra；邮箱验证码等缓存数据，连接统一走 pkg/redis）----
# 访问密码：openssl rand -hex 16
GANRAG_REDIS_PASSWORD=change-me-redis

# ---- JWT（user 签发 + gateway 验签共享密钥，两边必须相同）----
# 生成：openssl rand -base64 32
GANRAG_JWT_SECRET=change-me-jwt-secret

# ---- Garage 对象存储（task infra）----
# Garage 集群内部 RPC 密钥：openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-rpc-secret
# Garage 管理 API token：openssl rand -base64 32
GARAGE_ADMIN_TOKEN=change-me-admin-token
# 首次启动自动创建的 S3 密钥与桶（桶私有；AK/SK 后续由 Repository 的 objectstore 配置读取）
# Access Key ID 格式 GK + 32 位十六进制：echo "GK$(openssl rand -hex 16)"
GARAGE_DEFAULT_ACCESS_KEY=GKchange-me-access-key
# Secret Key：openssl rand -hex 32
GARAGE_DEFAULT_SECRET_KEY=change-me-secret-key
GARAGE_DEFAULT_BUCKET=ganrag-objects
# Repository 默认复用上述 GARAGE_DEFAULT_*；如需独立 S3 凭证可覆盖（config.yaml 的 objectstore 段）：
# GANRAG_OBJECTSTORE_ENDPOINT=http://127.0.0.1:3900
# GANRAG_OBJECTSTORE_ACCESS_KEY_ID=
# GANRAG_OBJECTSTORE_SECRET_ACCESS_KEY=

# ---- 网关（可选）----
# 容器网络内覆盖 user 服务地址（本地默认 127.0.0.1:50051，见 service/gateway/configs/config.yaml）
# GANRAG_UPSTREAM_USER=ganrag-user:50051

# ---- 邮件（验证码发送通道；SMTP 申请后解开填值）----
# 未配置 mail.host 时验证码降级写日志（仅限本地开发，生产必须配置）
# GANRAG_MAIL_HOST=smtp.example.com
# GANRAG_MAIL_PORT=587
# GANRAG_MAIL_USERNAME=
# GANRAG_MAIL_PASSWORD=
# GANRAG_MAIL_FROM=noreply@example.com
